# Example Streamlit secrets for running Care360 Evidence Copilot OUTSIDE
# Snowflake (for example on Streamlit Community Cloud).
#
# Do NOT commit a real secrets.toml -- .gitignore blocks it. This file is a
# template only, so every value is intentionally left empty.
#
# On Streamlit Community Cloud, paste these values into
# App settings » Secrets rather than committing them anywhere.
#
# When the app runs as Streamlit in Snowflake none of this is needed:
# the app uses the active session automatically.

[snowflake]
account = ""      # e.g. JRMWQMS-PA19066
user = ""         # your Snowflake login name
role = "CARE360_RW_ROLE"
warehouse = "CARE360_WH"
database = "PATIENT360"
schema = "ANALYTICS"

# Authentication. Fill in exactly one of the following.
# Either your account password, or a programmatic access token used in its
# place. Leave empty here and set the real value in the hosting provider's
# secret store.
password = ""

# Required ONLY for the natural-language (Cortex Analyst) chat path.
# The Snowflake REST APIs accept PAT, key-pair JWT, or OAuth -- but NOT
# password authentication -- so this specific feature needs a token.
# Create one with:
#   ALTER USER IF EXISTS <user> ADD PROGRAMMATIC ACCESS TOKEN CARE360_APP_PAT
#     ROLE_RESTRICTION = 'CARE360_RW_ROLE' DAYS_TO_EXPIRY = 30;
# Dashboards and document search work without it.
pat = ""
