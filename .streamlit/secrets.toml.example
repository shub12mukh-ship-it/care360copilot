# Example Streamlit secrets for running Care360 Evidence Copilot OUTSIDE
# Snowflake (for example on Streamlit Community Cloud).
#
# Do NOT commit a real secrets.toml -- .gitignore blocks it. This file is a
# template only, so every value is intentionally left empty.
#
# On Streamlit Community Cloud, paste these values into
# App settings » Secrets rather than committing them anywhere.
#
# When the app runs as Streamlit in Snowflake none of this is needed:
# the app uses the active session automatically.

[snowflake]
account = ""      # e.g. JRMWQMS-PA19066
user = ""         # your Snowflake login name
role = "CARE360_RW_ROLE"
warehouse = "CARE360_WH"
database = "PATIENT360"
schema = "ANALYTICS"

# AUTHENTICATION -- set `pat` and you are done.
#
# A programmatic access token is used in place of a password, and the app
# will use `pat` for both the database connection and the Cortex Analyst
# REST call. Create one with:
#
#   ALTER USER IF EXISTS <user> ADD PROGRAMMATIC ACCESS TOKEN CARE360_APP_PAT
#     ROLE_RESTRICTION = 'CARE360_RW_ROLE'
#     DAYS_TO_EXPIRY = 30
#     MINS_TO_BYPASS_NETWORK_POLICY_REQUIREMENT = 43200;
#
# The token secret is shown ONCE, in the token_secret column. Copy it with no
# surrounding whitespace. If you lose it, rotate the token to get a new one.
pat = ""

# Optional. Only set this if you want to connect with an account password
# instead of a token. Leave it empty when using `pat`.
# NOTE: a password works for the dashboards but NOT for the Cortex Analyst
# chat path, because the Snowflake REST APIs do not accept password auth.
password = ""
